# MinIO local S3 emulation (see docs/local-dev.md)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# LLM fallback stage (#41, src/capitol_lake/llm_providers.py). Provider is
# "lm_studio" (default, local, no key), "gemini" or "groq".
LLM_FALLBACK_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gemma-3-27b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
