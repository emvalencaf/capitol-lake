#!/usr/bin/env bash
# Validates the commit message against CONTRIBUTING.md.
set -euo pipefail
msg_file="$1"
title="$(grep -v '^#' "$msg_file" | sed -n '1p')"

# Merge and revert commits generated by git are exempt.
[[ "$title" =~ ^(Merge|Revert)\  ]] && exit 0

pattern='^(feat|fix|docs|refactor|style|test|chore|build|ci|perf|revert)\([a-z0-9._-]+(/[a-z0-9._-]+)?\): .+'
if ! [[ "$title" =~ $pattern ]]; then
  echo "commit-msg: title must match 'tag(subject/subsubject): summary'" >&2
  echo "  got: $title" >&2
  exit 1
fi
if ! grep -qE "^Session-Id: ." "$msg_file"; then
  echo "commit-msg: missing trailer 'Session-Id:'" >&2
  exit 1
fi
